<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Standalone on purpose: NO <parent>. A parent POM can contribute <dependencies> to this module, which
      would silently defeat the zero-dependency guarantee this artifact is built around (enforced below). Everything this
      module needs is declared here.
    -->
    <groupId>it.ddot</groupId>
    <artifactId>ddotit-core</artifactId>
    <version>0.3.2-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>ddot.it core</name>
    <description>
        The ddot.it syntax and event model with ZERO third-party dependencies except org.jspecify:jspecify
        (annotations only).
    </description>
    <url>https://ddot.it</url>

    <!-- Metadata Maven Central requires on every published POM. -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Max Völkel</name>
            <email>mv@maxvoelkel.de</email>
            <organization>Calpano</organization>
            <organizationUrl>https://calpano.com</organizationUrl>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/Calpano/ddot.it-java-core.git</connection>
        <developerConnection>scm:git:git@github.com:Calpano/ddot.it-java-core.git</developerConnection>
        <url>https://github.com/Calpano/ddot.it-java-core</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.14.3</junit.version>
        <truth.version>1.4.5</truth.version>
        <jspecify.version>1.0.0</jspecify.version>
        <jackson.version>3.2.4</jackson.version>
    </properties>

    <dependencies>
        <!-- The only dependency a consumer gets: annotations, no code. Enforced below. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>

        <!-- Testing (test scope only; never on a consumer's classpath) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.truth</groupId>
            <artifactId>truth</artifactId>
            <version>${truth.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Vulnerable (CVE-2026-110257 et al.); Truth only uses it to enrich failure messages -->
                <exclusion>
                    <groupId>org.ow2.asm</groupId>
                    <artifactId>asm</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- DdotCorpusConformanceTest builds the corpus' JSON for comparison -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!--
              Also ship the tests as ddotit-core:tests. adir runs the CDS engine contracts on graphs only
              adir can read (CdsRealCorpusContract, the benchmarks on real corpora); it gets the contracts
              and the corpora from here rather than keeping copies.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Guards the invariant this artifact is built around: a consumer gets ddot-core and jspecify
              (annotations only), nothing else.

              It was given up once, when the Kbase/Kgraph model moved in from ddotit-javalib: that model is
              built on graphinout's JSON document types and pulled base-api, the foundation-* modules,
              jackson and slf4j onto every consumer's classpath. The model now lives in its own artifact,
              it.ddot:ddotit-kbase (repository ddot.it-java-kbase), which depends on this one, and the rule
              is back.

              It also keeps the graphinout build cycle closed for good: graphinout's reader-ddot depends on
              ddot-core, so ddot-core must not depend on any graphinout module. ddotit-kbase carries the
              finer rule for that (only base-api and foundation-* may be used there).

              Every compile/runtime/provided/system dependency is banned, transitively, and only jspecify is
              re-allowed. The 5th pattern segment is the scope, so test-scope trees stay untouched: they
              never reach a consumer's classpath.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>ddot-core-depends-on-jspecify-only</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <message>
                                        ddot-core depends on org.jspecify:jspecify and nothing else. Code that
                                        needs more (e.g. graphinout's JSON types) belongs in ddotit-kbase or
                                        another module that depends on ddot-core.
                                    </message>
                                    <excludes>
                                        <exclude>*:*:*:*:compile</exclude>
                                        <exclude>*:*:*:*:runtime</exclude>
                                        <exclude>*:*:*:*:provided</exclude>
                                        <exclude>*:*:*:*:system</exclude>
                                    </excludes>
                                    <includes>
                                        <include>org.jspecify:jspecify:*:*:compile</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Releases go to Maven Central (namespace it.ddot), the same way as ../graphinout (its
              how-to-release.adoc): `mvn release:prepare` and `release:perform` with the profiles
              central-deploy (local, in ~/.m2/settings.xml) and sign-for-sonar (below), then a click on
              Publish at https://central.sonatype.com/publishing/deployments. Central wants sources and
              javadoc next to every jar, so they are built always; the GPG signature only in a release.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                            <goal>test-jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <locale>en</locale>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Replaces maven-deploy-plugin. Uploads wait in the Central Portal until published by hand.
              0.12.0, not graphinout's 0.9.0: under Maven 3.10, 0.9.0 bundles maven-metadata-local.xml and
              _remote.repositories, and Central rejects the bundle ("content that does NOT have a .pom file").
            -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.12.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <!-- Only MD5 + SHA1, Central's required set. -->
                    <checksums>required</checksums>
                </configuration>
            </plugin>
            <!-- Tags keep this repository's form, v0.3.0, rather than the default artifactId-version. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.0.1</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>sign-for-sonar</id>
            <activation>
                <property><name>performRelease</name><value>true</value></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
