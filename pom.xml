<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Standalone on purpose: NO <parent>. A parent POM can contribute <dependencies> to this module, which
      would silently defeat the zero-dependency guarantee this artifact is built around. Everything this
      module needs is declared here.
    -->
    <groupId>it.ddot</groupId>
    <artifactId>ddotit-core</artifactId>
    <version>0.2.2-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>ddot.it core</name>
    <description>
        The ddot.it syntax and event model with ZERO third-party dependencies except org.jspecify:jspecify
        (annotations only).
    </description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.14.3</junit.version>
        <truth.version>1.4.5</truth.version>
        <jspecify.version>1.0.0</jspecify.version>
    </properties>

    <dependencies>
<dependency><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId><version>${jspecify.version}</version></dependency>
<dependency><groupId>com.graphinout</groupId><artifactId>base-api</artifactId><version>0.2.2-SNAPSHOT</version></dependency>

        <!-- Testing (test scope only; never on a consumer's classpath) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.truth</groupId>
            <artifactId>truth</artifactId>
            <version>${truth.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!--
              Guards the BUILD CYCLE, which is the invariant that actually has teeth.

              This used to enforce "ddot-core depends on jspecify and nothing else". That claim died
              when the Kbase/Kgraph model moved in from ddotit-javalib: it is built on graphinout's
              JSON document types, so ddot-core now has a compile dependency on com.graphinout:base-api
              and, transitively, the foundation-* modules, jackson and slf4j. A rule asserting the old
              invariant could only fail, so it is gone rather than skipped — a permanently-skipped
              rule teaches everyone to pass -Denforcer.skip and hides the one below with it.

              What must still hold is acyclicity. graphinout's reader-ddot depends on ddot-core, so
              ddot-core may only depend on graphinout modules that sit BELOW reader-ddot in the stack:

                  base-api, foundation-*   ->  ddot-core  ->  base  ->  reader-ddot

              base-api and the foundation-* modules do not depend on ddot-core, so that chain is a DAG
              and builds in the order shown. Reaching for com.graphinout:base itself — or any reader,
              the engine, or the cli — closes the loop and makes the two repositories unbuildable from
              a clean ~/.m2. The rule below is exactly that line: every com.graphinout artifact is
              banned, and only the below-the-line modules are re-allowed.

              The 5th pattern segment is the scope, so test-scope trees stay untouched: they never
              reach a consumer's classpath and so cannot form the cycle.

              banTransitiveDependencies is likewise gone — base-api legitimately brings a transitive
              tree now, so the rule cannot be satisfied.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>ddot-core-must-not-close-the-graphinout-cycle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <message>
                                        ddot-core may depend only on graphinout modules that sit BELOW
                                        reader-ddot: base-api and foundation-*. graphinout's reader-ddot
                                        depends on ddot-core, so depending on com.graphinout:base (or any
                                        reader / engine / cli) closes a build cycle and makes both
                                        repositories unbuildable from a clean ~/.m2.
                                    </message>
                                    <excludes>
                                        <exclude>com.graphinout:*:*:*:compile</exclude>
                                        <exclude>com.graphinout:*:*:*:runtime</exclude>
                                        <exclude>com.graphinout:*:*:*:provided</exclude>
                                        <exclude>com.graphinout:*:*:*:system</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.graphinout:base-api:*:*:compile</include>
                                        <include>com.graphinout:foundation-pure:*:*:compile</include>
                                        <include>com.graphinout:foundation-jvm:*:*:compile</include>
                                        <include>com.graphinout:foundation-shared:*:*:compile</include>
                                        <include>com.graphinout:foundation-emulation:*:*:compile</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github-maven-repo</id>
            <name>GitHub calpano Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/calpano/ddot.it-java-core</url>
        </repository>
    </distributionManagement>

</project>
